{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/refresh-all.js": { "maxDuration": 120 },
    "api/cron/update-projections.js": { "maxDuration": 60 }
  },
  "schedules": {
    "update-stocks": {
      "schedule": "0 2 * * 1-5",
      "path": "/api/cron/update-stocks",
      "requestMethod": "GET"
    },
    "update-sports": {
      "schedule": "0 6 * * *",
      "path": "/api/cron/update-sports",
      "requestMethod": "GET"
    },
    "update-college": {
      "schedule": "0 5 * * *",
      "path": "/api/cron/update-college",
      "requestMethod": "GET"
    },
    "update-events": {
      "schedule": "0 4 * * *",
      "path": "/api/cron/update-events",
      "requestMethod": "GET"
    },
    "update-billboard": {
      "schedule": "0 3 * * 5",
      "path": "/api/cron/update-billboard",
      "requestMethod": "GET"
    },
    "update-entertainment": {
      "schedule": "0 3 * * 1",
      "path": "/api/cron/update-entertainment",
      "requestMethod": "GET"
    },
    "update-country": {
      "schedule": "0 7 1 * *",
      "path": "/api/cron/update-country",
      "requestMethod": "GET"
    },
    "snapshot-scores": {
      "schedule": "0 8 * * *",
      "path": "/api/cron/snapshot-scores",
      "requestMethod": "GET"
    },
    "update-projections": {
      "schedule": "0 9 * * *",
      "path": "/api/cron/update-projections",
      "requestMethod": "GET"
    }
  }
}
