# Mixpanel project token (Project Settings → Access Keys → Project Token in Mixpanel).
# Set the real value in Vercel: Project → Settings → Environment Variables.
# Must be prefixed REACT_APP_ for Create React App to expose it to the client bundle.
REACT_APP_MIXPANEL_TOKEN=

# Existing commissioner allow-list env var (unrelated to analytics, documented here for completeness).
REACT_APP_COMMISSIONER_EMAILS=

# PayPal Client ID for the commissioner Paywall feature (src/components/PayPalButton.jsx).
# This is the PUBLIC client ID, safe to expose client-side — not a secret key.
# Get it from the PayPal Developer Dashboard -> Apps & Credentials -> your app.
# Use a Sandbox app's client ID to test before switching to a Live app's client ID.
REACT_APP_PAYPAL_CLIENT_ID=

# Web Push (PWA push notifications — see AGENTS.md's "Push notifications"
# section). Generate a key pair once with `npx web-push generate-vapid-keys`
# and set all three in Vercel. The public key is REACT_APP_-prefixed so CRA
# inlines it into the client bundle for pushManager.subscribe(); the
# private key is NOT, so it stays server-only.
REACT_APP_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services (Apple/Google/Mozilla) may use to reach the
# site owner about this VAPID identity — never shown to end users.
VAPID_SUBJECT=mailto:you@example.com
